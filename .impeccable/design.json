  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default control: dark fill, quiet, flat.",
      "html": "<button class=\"ds-btn\">Trier par couleur</button>",
      "css": ".ds-btn{font:inherit;color:var(--text,#f1f5f2);background:var(--panel-2,#213328);border:1px solid var(--border-strong,#2f4a3b);border-radius:8px;padding:8px 14px;cursor:pointer;transition:background .15s,transform .1s}.ds-btn:hover{background:#2b4334}.ds-btn:focus-visible{outline:2px solid var(--gold,#e6b84f);outline-offset:2px}.ds-btn:active{transform:translateY(1px)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action that moves the game forward.",
      "html": "<button class=\"ds-btn-primary\">Défausser</button>",
      "css": ".ds-btn-primary{font:inherit;font-weight:600;color:#1a1500;background:var(--gold,#e6b84f);border:1px solid var(--gold-dark,#b98b23);border-radius:8px;padding:8px 14px;cursor:pointer;transition:background .15s,transform .1s}.ds-btn-primary:hover{background:#f0c866}.ds-btn-primary:focus-visible{outline:2px solid var(--gold,#e6b84f);outline-offset:2px}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Dark well with a gold caret and gold focus outline.",
      "html": "<input class=\"ds-input\" placeholder=\"Votre prénom\">",
      "css": ".ds-input{font:inherit;color:var(--text,#f1f5f2);background:#0e1712;border:1px solid var(--border-strong,#2f4a3b);border-radius:8px;padding:9px 12px;caret-color:var(--gold,#e6b84f)}.ds-input:focus{outline:2px solid var(--gold,#e6b84f);outline-offset:1px}"
    },
    {
      "name": "Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Pill label; gold for your own seat.",
      "html": "<span class=\"ds-tag\">hôte</span> <span class=\"ds-tag ds-tag-you\">vous</span>",
      "css": ".ds-tag{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;background:#2b4334;color:var(--muted,#a9b8ae)}.ds-tag-you{background:var(--gold,#e6b84f);color:#1a1500}"
    },
    {
      "name": "Playing Card",
      "kind": "custom",
      "refersTo": "playing-card",
      "description": "Ivory face; selected cards lift with a gold ring and order badge; focus is white.",
      "html": "<button class=\"ds-card ds-red\"><span class=\"ds-corner\"><b>Q</b><i>♥</i></span><span class=\"ds-center\">♥</span></button><button class=\"ds-card ds-black ds-selected\"><span class=\"ds-corner\"><b>7</b><i>♠</i></span><span class=\"ds-center\">♠</span><span class=\"ds-order\">1</span></button>",
      "css": ".ds-card{position:relative;width:58px;height:82px;margin:16px 4px 0;border-radius:7px;background:#fdfdf8;border:1px solid #c9c9c0;padding:0;box-shadow:0 2px 4px rgba(0,0,0,.35);cursor:pointer;transition:transform .12s,box-shadow .12s;font-family:inherit}.ds-red{color:#c8322b}.ds-black{color:#14161c}.ds-corner{position:absolute;top:3px;left:5px;display:grid;line-height:1;text-align:left}.ds-corner b{font-size:15px}.ds-corner i{font-style:normal;font-size:12px}.ds-center{position:absolute;inset:0;display:grid;place-items:center;font-size:30px}.ds-card:hover{transform:translateY(-4px)}.ds-card:focus-visible{outline:3px solid #f1f5f2;outline-offset:3px}.ds-selected,.ds-selected:hover{transform:translateY(-14px);box-shadow:0 0 0 3px #e6b84f,0 6px 10px rgba(0,0,0,.4)}.ds-order{position:absolute;top:-8px;right:-6px;width:18px;height:18px;border-radius:50%;background:#e6b84f;color:#1a1500;font-size:11px;font-weight:700;display:grid;place-items:center}"
    },
    {
      "name": "Card Back (stock)",
      "kind": "custom",
      "refersTo": "playing-card-back",
      "description": "The only blue in the system; carries the stock count.",
      "html": "<button class=\"ds-back\"><span class=\"ds-pattern\"></span><span class=\"ds-count\">78</span></button>",
      "css": ".ds-back{position:relative;width:58px;height:82px;border-radius:7px;background:#2c4a8a;border:1px solid #1a2f5c;padding:0;box-shadow:0 2px 4px rgba(0,0,0,.35);cursor:pointer}.ds-pattern{position:absolute;inset:5px;border-radius:4px;border:2px solid #a9c1f2;background:repeating-linear-gradient(45deg,#3b5fa8 0 4px,#2c4a8a 4px 8px)}.ds-count{position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-weight:700;font-size:16px;text-shadow:0 1px 3px #000}.ds-back:focus-visible{outline:3px solid #f1f5f2;outline-offset:3px}"
